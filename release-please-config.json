{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "rust",
  "bump-minor-pre-major": true,
  "separate-pull-requests": false,
  "packages": {
    "crates/tela": { "component": "tela" },
    "crates/tela-cli": { "component": "tela-cli" }
  },
  "plugins": [
    "cargo-workspace",
    { "type": "linked-versions", "groupName": "tela", "components": ["tela", "tela-cli"] }
  ]
}
